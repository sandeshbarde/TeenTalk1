# Local API server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication: replace with a random secret before deployment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Evidence files are encrypted with AES-256-GCM.
# Provide exactly 32 random bytes as 64 hexadecimal characters in production.
EVIDENCE_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

# Optional Supabase connection. Keep service-role credentials on the server only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_NAME=complaint-evidence
